<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<Package
		Name="Mylange"
		Manufacturer="Myriware Solutions"
		Version="1.0.0.0"
		UpgradeCode="E66EB03D-3691-4E30-9D82-21A0436AF01F"
		Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

		<!-- App icon for Add/Remove Programs -->
		<Icon Id="MylangeIcon" SourceFile="Assets\MylangeEye_2026_black.ico" />
		<Property Id="ARPPRODUCTICON" Value="MylangeIcon" />

		<!-- Built-in WiX UI -->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

		<MediaTemplate />

		<Feature Id="MainFeature" Title="Mylange" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
			<ComponentGroupRef Id="PathComponents" />
		</Feature>

	</Package>

	<Fragment>
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="Mylange" />
		</StandardDirectory>

		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="ApplicationProgramsFolder" Name="Mylange" />
		</StandardDirectory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="MainExecutable" Guid="E95B6197-42CE-437F-930A-774BDC548823">
				<!-- With the project reference, this can usually be just the file name -->
				<File Id="MylangeExe" Source="Mylange.exe" KeyPath="yes">
					<Shortcut
						Id="StartMenuShortcut"
						Directory="ApplicationProgramsFolder"
						Name="Mylange"
						Description="Mylange Language Interpreter"
						Icon="MylangeIcon"
						IconIndex="0"
						WorkingDirectory="INSTALLFOLDER"
						Advertise="yes" />
				</File>

				<!-- .myl file association -->
				<ProgId Id="Mylange.Script" Description="Mylange Script" Icon="MylangeIcon">
					<Extension Id="myl" ContentType="application/x-mylange">
						<Verb Id="open" Command="open" TargetFile="MylangeExe" Argument="&quot;%1&quot;" />
					</Extension>
				</ProgId>

				<!-- Optional: associate the extension with this ProgId on install -->
				<RegistryValue
					Root="HKCU"
					Key="Software\Classes\.myl"
					Name=""
					Type="string"
					Value="Mylange.Script"
					KeyPath="yes" />
			</Component>

			<Component Id="StartMenuCleanup" Guid="*"
					   Directory="ApplicationProgramsFolder">
				<RemoveFolder Id="RemoveApplicationProgramsFolder"
							  Directory="ApplicationProgramsFolder"
							  On="uninstall" />
				<RegistryValue Root="HKCU"
							   Key="Software\MyriwareSolutions\Mylange"
							   Name="StartMenuInstalled"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />
			</Component>
		</ComponentGroup>

		<ComponentGroup Id="PathComponents" Directory="INSTALLFOLDER">
			<Component Id="AddToPath" Guid="*">
				<Environment
					Id="MylangePath"
					Name="PATH"
					Value="[INSTALLFOLDER]"
					Action="set"
					Part="last"
					System="yes"
					Permanent="no"
					KeyPath="yes" />
			</Component>
		</ComponentGroup>
	</Fragment>

</Wix>