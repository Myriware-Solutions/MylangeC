<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

	<Fragment>
		<!-- Icon declaration -->
		<Icon Id="MylangIcon" SourceFile="MylangeEye_2026_black.ico" />
	</Fragment>
	
	
	<Fragment>
		
		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

			

			<!-- Main executable -->
			<Component Id="MainExecutable" Guid="D3997AE3-51B6-4B8C-B163-F643FB3DCC3C">
				<File
                    Id="MylangExe"
                    Source="$(var.Mylange.TargetPath)"
                    KeyPath="yes">

					<!-- Start menu shortcut -->
					<Shortcut
                        Id="StartMenuShortcut"
                        Directory="ApplicationProgramsFolder"
                        Name="Mylange"
                        Description="Mylange Interpreter"
						Icon="MylangIcon"
                        IconIndex="0"
                        WorkingDirectory="INSTALLFOLDER"
                        Advertise="yes" />
				</File>

				<!-- .myl file association -->
				<ProgId Id="Mylange.Script" Description="Mylange Script" Icon="MylangIcon">
					<Extension Id="myl" ContentType="application/x-mylange">
						<Verb Id="open" Command="Run" TargetFile="MylangExe" Argument='"%1"' />
					</Extension>
				</ProgId>
			</Component>

			<!-- Icon file -->
			<Component Id="IconComponent" Guid="FC07464A-5480-410D-8A57-68D2FD6C8FB5">
				<File
                    Id="MylangIconFile"
                    Source="C:\Users\antma\source\repos\Myriware-Solutions\MylangeC\MylangeInstaller\MylangeEye_2026_black.ico"
                    KeyPath="yes" />
			</Component>

			<!-- Clean up start menu folder on uninstall -->
			<Component Id="StartMenuCleanup" Guid="C9A00CE7-2D14-4195-95A5-E8A54204AD69"
                       Directory="ApplicationProgramsFolder">
				<RemoveFolder Id="RemoveApplicationProgramsFolder"
                              Directory="ApplicationProgramsFolder"
                              On="uninstall" />
				<RegistryValue Root="HKCU"
                               Key="Software\MylwareSolutions\Mylange"
                               Name="StartMenuInstalled"
                               Type="integer" Value="1"
                               KeyPath="yes" />
			</Component>

		</ComponentGroup>

		<!-- PATH environment variable — separate component group -->
		<ComponentGroup Id="PathComponent" Directory="INSTALLFOLDER">
			<Component Id="PathEntry" Guid="CE0F9422-6CA9-4078-97D2-6BC05757DDBD" KeyPath="yes">
				<Environment
                    Id="PATH"
                    Name="PATH"
                    Value="[INSTALLFOLDER]"
                    Permanent="no"
                    Part="last"
                    Action="set"
                    System="yes" />
			</Component>
		</ComponentGroup>

		

	</Fragment>
</Wix>