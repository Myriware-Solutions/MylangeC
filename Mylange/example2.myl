class Dumb has {

    public int Age => 0;

    public def nil Dumb(int age, str something) as {
        io.print("Constructor called" .. age);

    };

    public def nil Anything() as {
        io.print("Anything called from Dumb: 0" .. this:Age);
    };

};

io.dump();
io.dumpClass("file.File");
io.dumpClass(Dumb);

Dumb bob => new Dumb(3, "Something");
bob.Anything();




