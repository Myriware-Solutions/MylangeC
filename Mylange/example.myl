bool Running => true;

while (Running) do {
    set ExampleSet => (
        name=>io.input("Name > "), 
        age=>std.to_int(io.input("Age > "))
    );

    for ([string key, any value] in ExampleSet) do {
        io.print("Key: " .. key .. " / value: (" .. std.typeof(value) .. ")" .. std.to_string(value));
        if (key == "name" && value == "Anthony") then {
            io.print("Hello, dup.");
        };
    };

    if (io.input("cont  [y/n]> ") == "n") then Running => false;
};



