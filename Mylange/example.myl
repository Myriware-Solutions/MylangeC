class Person has {

    public str Property;
    public str DefualtedProperty => "something";

    public def nil Person(int age, str something) as {
        io.print("Constructor called" .. age);
        this:Property => something;
    };

    public def str Name() as {
        io.print("Name called from Person");
    };

};

class Friend extends Person has {

    @override public str DefualtedProperty => "something else";

    @override
    public def str Name() as {
        io.print("Name called from Friend");
    };

};

std.ClassPrintout();

Person anthony => new Person(3, "Something");

anthony.Name();

